# Copy this file to .env and fill in real values. Never commit .env — it is gitignored.
#
# Required to use the Gemini Vision provider (packages/discovery-core/src/vision/provider.ts).
# Get a key at https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=

# Optional. Overrides the default Gemini model used for Vision analysis (gemini-3.6-flash).
# Only needed if you want to pin a different model version.
GEMINI_VISION_MODEL=

# --- Database (packages/discovery-db) --------------------------------------------------------
# Either set DATABASE_URL directly (it takes precedence over the POSTGRES_* variables below —
# this is what a hosted Postgres provider typically gives you), or use docker-compose up -d /
# npm run db:local:up with the discrete variables below.
# DATABASE_URL=postgresql://discovery:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/discovery_platform
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=discovery
POSTGRES_PASSWORD=discovery_local_dev
POSTGRES_DB=discovery_platform
POSTGRES_SSL=false

# --- API (apps/api) ----------------------------------------------------------------------------
# Required. Signs the session cookie — see apps/api/src/auth/session.ts. Use a long random value
# (e.g. `openssl rand -hex 32`); never reuse the example value below outside local development.
SESSION_SECRET=replace-with-a-long-random-value

# The Web App's own origin — only this origin may send credentialed (cookie-carrying) requests
# to the API. Defaults to http://localhost:5173 (Vite's default dev port) if unset.
WEB_ORIGIN=http://localhost:5173

# Optional. When set, every request may also authenticate with this value as the x-api-key
# header, as an alternative to a logged-in session — local scripts/tests only, never real Web
# App auth (see docs/architecture.md). Leave unset unless you need it. In production
# (NODE_ENV=production), setting this WITHOUT ALLOW_DEV_API_KEY_IN_PRODUCTION=1 below makes the
# server refuse to start — the dev key must never be enabled for the real Web App by accident.
API_DEV_KEY=

# Only read when NODE_ENV=production and API_DEV_KEY is set — an explicit, separate opt-in
# required to allow the dev key in a deployed environment (local/technical testing only; see
# docs/deployment.md). Leave unset; there is no reason to set this for the Web App itself.
ALLOW_DEV_API_KEY_IN_PRODUCTION=

# Optional. Port the API listens on. Cloud Run sets its own PORT automatically; this is the
# local-development fallback name kept for backwards compatibility.
API_PORT=3000

# --- Single-origin production serving (apps/api) -----------------------------------------------
# Optional, and only meaningful in a real deployment (see docs/deployment.md) — when set, this
# same Express process also serves the built Web App (apps/web/dist) as static files, with an
# index.html fallback for client-side routes, so the API and Web App share one origin and the
# session cookie stays first-party. Leave unset locally: Vite and the API keep running separately.
WEB_DIST_DIR=

# --- Web App (apps/web) --------------------------------------------------------------------
# The API base URL the Web App calls. Defaults to http://127.0.0.1:3000/api/v1 if unset — set
# this as a Vite env var (VITE_API_URL) when running apps/web, not here in the root .env. The
# production Docker image builds the Web App with VITE_API_URL=/api/v1 (same-origin) instead —
# see the Dockerfile and docs/deployment.md.
# VITE_API_URL=http://127.0.0.1:3000/api/v1
#
# Optional. Shows a small "Testomgeving" badge in the Web App when set (the Dockerfile sets it
# for the online test deployment) — leave unset locally.
# VITE_ENV_LABEL=
