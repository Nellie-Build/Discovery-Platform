{
  "name": "@discovery-platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "Discovery Platform's HTTP API — composes @discovery-platform/core, a domain registry (currently just vacancies) and @discovery-platform/db. Contains no domain-specific parsing of its own; every domain field lives in a domain module.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@discovery-platform/core": "^0.1.0",
    "@discovery-platform/db": "^0.1.0",
    "@discovery-platform/domain-vacancies": "^0.1.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.13.4",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "typescript": "^7.0.2"
  }
}
